  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ca285d7e14ff8554aa1ae46b21d832dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 606020930}
  MrCentImage: {fileID: 856060970}
  registerScreen: {fileID: 1783369466}
  scanningScreen: {fileID: 842601309}
  baggingScreen: {fileID: 233419633}
  checkoutScreen: {fileID: 596811369}
  settingsScreen: {fileID: 1179081324}
  lines:
  - Greetings new employee!
  - Congratulations on getting hired at your local grocery store!
  - I'm Mr. Cent!
  - Welcome to the biggest, the greatest, & most famous digital grocery chain in
    the world, Mr. Cent's Centopia!
  - Here you'll be learning how to be the best cashier you can be with this rigorous
    training course!
  - I'll be your guide to your future and successful grocery career!
  - So, let me show you how to get started!
  - When you arrive in the store, use WASD to move around! Move in front of the register
    with customers and click the left mouse button!
  - Once at your station, click and hold the left mouse button on an item. Move it
    over the scanner to scan it! Set it to the side afterward!
  - When you want to bag items, move your mouse over to the left of the register
    and press the left mouse button! Then click and drag items like before to the
    grey bagging area.
  - If you wish to move back to the register, move your mouse to the right and click
    the left mouse button. If all items have been scanned, you can press the checkout
    button to bring in a new customer!
  - Lastly, you can look through different settings and menus by pressing the left
    mouse button on the icon to the right to navigate the menus.
  - And that's all you need to know for your first day!
  - Good luck and make this cent proud!
  textSpeed: 0.1
  textCount: 0
